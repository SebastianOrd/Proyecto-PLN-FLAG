# Dockerfile.streamlit.cloudrun - Optimizado para Google Cloud Run
FROM python:3.11-slim

WORKDIR /app

# Variables de entorno para Cloud Run
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar Streamlit y requests
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    streamlit==1.31.0 \
    requests==2.31.0 \
    joblib==1.3.2 \
    scikit-learn==1.4.2

# Copiar código fuente
COPY src /app/src

# Exponer puerto
EXPOSE 8080

# Comando para Cloud Run - usar flags en lugar de config file
CMD streamlit run src/ui/app_streamlit.py \
    --server.port=8080 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --browser.gatherUsageStats=false \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false